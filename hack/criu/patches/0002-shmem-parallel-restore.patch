+/*
+ * Parallel memfd restore.
+ *
+ * open_vmas() walks a process's VMAs one at a time, and for each shared
+ * anonymous mapping open_shmem() does the whole of create -> resize -> map ->
+ * read -> next before the walk moves on. Every one of those reads is a
+ * synchronous pread against the pages image, so a task with many shmem
+ * objects restores them strictly one after another and leaves most of the
+ * device's read bandwidth unused.
+ *
+ * That ordering costs nothing to give up: distinct shmem objects have no
+ * dependency on each other. This pass restores their contents up front, on a
+ * pool of threads, and leaves the memfd on si->prep_fd. open_shmem() then
+ * adopts it and skips straight to the part that does have ordering
+ * constraints -- publishing si->fd and the futex handshake with the slave
+ * processes, which stays exactly as it was, on the main thread.
+ *
+ * It matters most where it was measured: a GPU checkpoint. cuda-checkpoint
+ * parks device memory in host buffers that CRIU sees as memfds, so on a
+ * checkpoint of a 14B-parameter vLLM engine 205 of the 208 page images were
+ * shmem ones -- essentially the whole 52 GiB.
+ */
+
+#define SHMEM_RESTORE_THREADS_MAX 32
+
+struct shmem_prep_job {
+	struct shmem_info *si;
+	int ret;
+};
+
+struct shmem_prep_pool {
+	struct shmem_prep_job *jobs;
+	unsigned int nr_jobs;
+	unsigned int next;
+	pthread_mutex_t lock;
+};
+
+/*
+ * How many objects to restore at once. Shared with the memfd pass, which has
+ * exactly the same shape of work and no reason to be tuned separately. Bounded by the number of CPUs the
+ * restore is allowed to use; CRIU_SHMEM_RESTORE_THREADS overrides it, and 1
+ * turns the pass off entirely (open_shmem() then does the work inline, as
+ * before).
+ */
+unsigned int shmem_restore_threads(void)
+{
+	const char *env = getenv("CRIU_SHMEM_RESTORE_THREADS");
+	long nr;
+
+	if (env && *env) {
+		char *end;
+
+		nr = strtol(env, &end, 10);
+		if (*end || nr < 1) {
+			pr_warn("Ignoring bad CRIU_SHMEM_RESTORE_THREADS=%s\n", env);
+			nr = 0;
+		}
+	} else {
+		nr = 0;
+	}
+
+	if (!nr) {
+		nr = sysconf(_SC_NPROCESSORS_ONLN);
+		if (nr < 1)
+			nr = 1;
+		if (nr > 8)
+			nr = 8;
+	}
+
+	if (nr > SHMEM_RESTORE_THREADS_MAX)
+		nr = SHMEM_RESTORE_THREADS_MAX;
+
+	return (unsigned int)nr;
+}
+
+/*
+ * Fill one memfd with its checkpointed contents. Everything here is
+ * per-object state: the memfd, its mapping, and the page_read that
+ * restore_shmem_content() opens against this object's own image files. No
+ * two workers touch the same shmem_info.
+ */
+static int shmem_prep_one(struct shmem_info *si)
+{
+	void *addr;
+	int f;
+
+	f = memfd_create("", 0);
+	if (f < 0) {
+		pr_perror("Unable to create memfd for shmem 0x%lx", si->shmid);
+		return -1;
+	}
+
+	if (ftruncate(f, si->size)) {
+		pr_perror("Unable to truncate memfd for shmem 0x%lx", si->shmid);
+		close(f);
+		return -1;
+	}
+
+	addr = mmap(NULL, si->size, PROT_WRITE | PROT_READ, MAP_SHARED | MAP_FILE, f, 0);
+	if (addr == MAP_FAILED) {
+		pr_perror("Can't mmap shmem 0x%lx size=%ld", si->shmid, si->size);
+		close(f);
+		return -1;
+	}
+
+	if (restore_shmem_content(addr, si) < 0) {
+		pr_err("Can't restore shmem 0x%lx content\n", si->shmid);
+		munmap(addr, si->size);
+		close(f);
+		return -1;
+	}
+
+	munmap(addr, si->size);
+	si->prep_fd = f;
+	return 0;
+}
+
+static void *shmem_prep_worker(void *arg)
+{
+	struct shmem_prep_pool *pool = arg;
+
+	while (1) {
+		struct shmem_prep_job *job;
+
+		pthread_mutex_lock(&pool->lock);
+		if (pool->next >= pool->nr_jobs) {
+			pthread_mutex_unlock(&pool->lock);
+			break;
+		}
+		job = &pool->jobs[pool->next++];
+		pthread_mutex_unlock(&pool->lock);
+
+		job->ret = shmem_prep_one(job->si);
+	}
+
+	return NULL;
+}
+
+/*
+ * Restore, in parallel, the contents of every shmem object this process owns
+ * and will have to create itself.
+ *
+ * Deliberately conservative about what it claims. Hugetlb mappings and the
+ * no-memfd fallback both need open_shmem()'s original path, and an object
+ * another process owns is that process's job -- anything not claimed here is
+ * simply left for open_shmem() to do inline, so the worst case is the old
+ * behavior rather than a broken restore.
+ *
+ * A failure is not fatal either: the object keeps prep_fd == -1 and
+ * open_shmem() retries it inline, where the error is reported in the context
+ * that has always reported it.
+ */
+int shmem_restore_parallel(int pid, struct list_head *vmas)
+{
+	struct shmem_prep_pool pool = {};
+	pthread_t threads[SHMEM_RESTORE_THREADS_MAX];
+	unsigned int nr_threads, i, started = 0;
+	struct vma_area *vma;
+	int ret = 0;
+
+	if (!kdat.has_memfd)
+		return 0;
+
+	nr_threads = shmem_restore_threads();
+	if (nr_threads < 2)
+		return 0;
+
+	/* Count first so the job array can be allocated in one go. */
+	list_for_each_entry(vma, vmas, list) {
+		struct shmem_info *si;
+
+		if (!vma_area_is(vma, VMA_AREA_REGULAR) || vma->vm_open != open_shmem)
+			continue;
+		if (vma->e->flags & MAP_HUGETLB)
+			continue;
+
+		si = shmem_find(vma->e->shmid);
+		if (!si || si->pid != pid || si->fd != -1 || si->prep_fd != -1)
+			continue;
+
+		/*
+		 * Claim it now, so a second VMA onto the same object does not
+		 * queue it twice. shmem_prep_one() overwrites this with the
+		 * real descriptor.
+		 */
+		si->prep_fd = -2;
+		pool.nr_jobs++;
+	}
+
+	if (pool.nr_jobs < 2) {
+		/* Nothing to overlap; undo the claims and let open_shmem work. */
+		list_for_each_entry(vma, vmas, list) {
+			struct shmem_info *si;
+
+			if (!vma_area_is(vma, VMA_AREA_REGULAR) || vma->vm_open != open_shmem)
+				continue;
+			si = shmem_find(vma->e->shmid);
+			if (si && si->prep_fd == -2)
+				si->prep_fd = -1;
+		}
+		return 0;
+	}
+
+	pool.jobs = xzalloc(pool.nr_jobs * sizeof(*pool.jobs));
+	if (!pool.jobs) {
+		ret = -1;
+		goto out_unclaim;
+	}
+
+	pool.nr_jobs = 0;
+	list_for_each_entry(vma, vmas, list) {
+		struct shmem_info *si;
+
+		if (!vma_area_is(vma, VMA_AREA_REGULAR) || vma->vm_open != open_shmem)
+			continue;
+
+		si = shmem_find(vma->e->shmid);
+		if (!si || si->prep_fd != -2)
+			continue;
+
+		pool.jobs[pool.nr_jobs].si = si;
+		pool.jobs[pool.nr_jobs].ret = -1;
+		pool.nr_jobs++;
+	}
+
+	if (nr_threads > pool.nr_jobs)
+		nr_threads = pool.nr_jobs;
+
+	pr_info("Restoring %u shmem objects on %u threads\n", pool.nr_jobs, nr_threads);
+	pthread_mutex_init(&pool.lock, NULL);
+
+	for (i = 0; i < nr_threads; i++) {
+		if (pthread_create(&threads[i], NULL, shmem_prep_worker, &pool)) {
+			pr_perror("Can't start shmem restore thread %u", i);
+			break;
+		}
+		started++;
+	}
+
+	if (started == 0) {
+		/* Could not start a single thread; do it all here. */
+		shmem_prep_worker(&pool);
+	} else {
+		/*
+		 * The caller's thread is one more pair of hands, and taking
+		 * jobs here means a failure to start every thread still makes
+		 * progress.
+		 */
+		shmem_prep_worker(&pool);
+		for (i = 0; i < started; i++)
+			pthread_join(threads[i], NULL);
+	}
+
+	pthread_mutex_destroy(&pool.lock);
+
+	for (i = 0; i < pool.nr_jobs; i++) {
+		if (pool.jobs[i].ret == 0)
+			continue;
+		/*
+		 * Leave it to open_shmem(): whatever went wrong will go wrong
+		 * again there, with the original error handling around it.
+		 */
+		pr_warn("Parallel restore of shmem 0x%lx failed; falling back to inline restore\n",
+			pool.jobs[i].si->shmid);
+		pool.jobs[i].si->prep_fd = -1;
+	}
+
+	xfree(pool.jobs);
+	return 0;
+
+out_unclaim:
+	list_for_each_entry(vma, vmas, list) {
+		struct shmem_info *si;
+
+		if (!vma_area_is(vma, VMA_AREA_REGULAR) || vma->vm_open != open_shmem)
+			continue;
+		si = shmem_find(vma->e->shmid);
+		if (si && si->prep_fd == -2)
+			si->prep_fd = -1;
+	}
+	return ret;
+}
