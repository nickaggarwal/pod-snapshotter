+/*
+ * Parallel memfd restore.
+ *
+ * Every memfd inode is otherwise created and filled the first time some task
+ * happens to open it -- one at a time, deep inside the serial file-restore
+ * walk, each fill a synchronous read against its own pages image. The
+ * contents of distinct inodes have no dependency on each other, so the whole
+ * set can be read at once instead.
+ *
+ * This is the half of the restore that matters on a GPU checkpoint:
+ * cuda-checkpoint parks device memory in host buffers that CRIU records as
+ * memfds, so on a checkpoint of a 14B-parameter vLLM engine 205 of the 208
+ * page images were memfd ones -- essentially the entire 52 GiB.
+ *
+ * The result is published through the fdstore, NOT as an fd number on the
+ * shared inode. memfd_open_inode_nocache() runs inside forked tasks that have
+ * already rebuilt their fd tables (setup_newborn_fds -> close_old_fds), so a
+ * descriptor opened here is not valid there and would be either closed or
+ * some unrelated file. fdstore_add() is exactly the mechanism CRIU already
+ * uses to hand a descriptor across that boundary, and memfd_open_inode()
+ * already prefers fdstore_id when it is set -- so a prepared inode needs no
+ * new lookup path, it simply arrives already cached.
+ *
+ * Best-effort: an inode that is not claimed, or that fails here, is left
+ * exactly as it was and gets restored inline as before.
+ */
+
+/*
+ * Defined below, next to the serial path it shares the seal decision with.
+ */
+static int memfd_create_inode(struct memfd_restore_inode *inode);
+
+#define MEMFD_RESTORE_THREADS_MAX 32
+
+struct memfd_prep_job {
+	struct memfd_restore_inode *inode;
+	int ret;
+};
+
+struct memfd_prep_pool {
+	struct memfd_prep_job *jobs;
+	unsigned int nr_jobs;
+	unsigned int next;
+	pthread_mutex_t lock;
+};
+
+static int memfd_prep_one(struct memfd_restore_inode *inode)
+{
+	MemfdInodeEntry *mie = inode->mie;
+	int fd, ret;
+
+	fd = memfd_create_inode(inode);
+	if (fd < 0) {
+		pr_perror("Can't create memfd:%s", mie->name);
+		return -1;
+	}
+
+	if (restore_memfd_shmem_content(fd, mie->shmid, mie->size)) {
+		close(fd);
+		return -1;
+	}
+
+	if (mie->has_mode)
+		ret = cr_fchperm(fd, mie->uid, mie->gid, mie->mode);
+	else
+		ret = cr_fchown(fd, mie->uid, mie->gid);
+	if (ret) {
+		pr_perror("Can't set permissions { uid %d gid %d mode %#o } of memfd:%s", (int)mie->uid,
+			  (int)mie->gid, mie->has_mode ? (int)mie->mode : -1, mie->name);
+		close(fd);
+		return -1;
+	}
+
+	/*
+	 * fdstore_add() sends the descriptor over a unix socket that every
+	 * forked task inherits, and takes desc->lock while doing so, so it is
+	 * safe to call from several workers at once.
+	 */
+	inode->fdstore_id = fdstore_add(fd);
+	close(fd);
+	if (inode->fdstore_id < 0)
+		return -1;
+
+	return 0;
+}
+
+static void *memfd_prep_worker(void *arg)
+{
+	struct memfd_prep_pool *pool = arg;
+
+	while (1) {
+		struct memfd_prep_job *job;
+
+		pthread_mutex_lock(&pool->lock);
+		if (pool->next >= pool->nr_jobs) {
+			pthread_mutex_unlock(&pool->lock);
+			break;
+		}
+		job = &pool->jobs[pool->next++];
+		pthread_mutex_unlock(&pool->lock);
+
+		job->ret = memfd_prep_one(job->inode);
+	}
+
+	return NULL;
+}
+
+static int memfd_restore_parallel(void)
+{
+	struct memfd_prep_pool pool = {};
+	pthread_t threads[MEMFD_RESTORE_THREADS_MAX];
+	unsigned int nr_threads, i, started = 0;
+	struct memfd_restore_inode *inode;
+
+	nr_threads = shmem_restore_threads();
+	if (nr_threads < 2)
+		return 0;
+	if (nr_threads > ARRAY_SIZE(threads))
+		nr_threads = ARRAY_SIZE(threads);
+
+	list_for_each_entry(inode, &memfd_inodes, list) {
+		if (inode->fdstore_id == -1 && inode->mie->size)
+			pool.nr_jobs++;
+	}
+
+	if (pool.nr_jobs < 2)
+		return 0;
+
+	pool.jobs = xzalloc(pool.nr_jobs * sizeof(*pool.jobs));
+	if (!pool.jobs)
+		return -1;
+
+	pool.nr_jobs = 0;
+	list_for_each_entry(inode, &memfd_inodes, list) {
+		if (inode->fdstore_id == -1 && inode->mie->size) {
+			pool.jobs[pool.nr_jobs].inode = inode;
+			pool.jobs[pool.nr_jobs].ret = -1;
+			pool.nr_jobs++;
+		}
+	}
+
+	if (nr_threads > pool.nr_jobs)
+		nr_threads = pool.nr_jobs;
+
+	pr_info("Restoring %u memfd inodes on %u threads\n", pool.nr_jobs, nr_threads);
+	pthread_mutex_init(&pool.lock, NULL);
+
+	for (i = 0; i < nr_threads; i++) {
+		if (pthread_create(&threads[i], NULL, memfd_prep_worker, &pool)) {
+			pr_perror("Can't start memfd restore thread %u", i);
+			break;
+		}
+		started++;
+	}
+
+	/* This thread is one more pair of hands, and covers started == 0. */
+	memfd_prep_worker(&pool);
+
+	for (i = 0; i < started; i++)
+		pthread_join(threads[i], NULL);
+
+	pthread_mutex_destroy(&pool.lock);
+
+	for (i = 0; i < pool.nr_jobs; i++) {
+		if (pool.jobs[i].ret == 0)
+			continue;
+		/*
+		 * Whatever went wrong will go wrong again inline, with the
+		 * original error handling around it. Reset the seal decision
+		 * this pass may have recorded so the retry starts clean.
+		 */
+		pr_warn("Parallel restore of memfd %s failed; falling back to inline restore\n",
+			pool.jobs[i].inode->mie->name);
+		pool.jobs[i].inode->fdstore_id = -1;
+		pool.jobs[i].inode->pending_seals = 0;
+	}
+
+	xfree(pool.jobs);
+	return 0;
+}
+
 int prepare_memfd_inodes(void)
 {
-	return collect_image(&memfd_inode_cinfo);
+	if (collect_image(&memfd_inode_cinfo))
+		return -1;
+
+	return memfd_restore_parallel();
 }
 
