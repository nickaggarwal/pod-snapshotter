+/*
+ * ---------------------------------------------------------------------------
+ * Native AIO for the async page-read path
+ * ---------------------------------------------------------------------------
+ *
+ * process_async_reads_serial() below reads each queued job with a blocking
+ * preadv() and does not start the next until that one has returned, so however
+ * many jobs are outstanding there is only ever one read in flight. On an NVMe
+ * device -- or a network-backed image, where it is worse -- that leaves most
+ * of the available read bandwidth unused for the whole restore.
+ *
+ * io_submit() lets the jobs that are already queued reach the device together.
+ * The window is a sliding one rather than "submit everything": a large
+ * checkpoint queues tens of thousands of jobs, and the kernel's AIO context is
+ * a fixed-size resource shared with the rest of the node.
+ *
+ * Not used when opts.auto_dedup is on. That path punches holes in the image as
+ * it reads, and interleaving that with reads still in flight is a change in
+ * behavior this has no need to make.
+ *
+ * Tunables, read from the environment so a caller can set them per-restore
+ * without touching the host's criu config:
+ *
+ *   CRIU_AIO_DEPTH       reads in flight; 0 or 1 restores the preadv() path
+ *   CRIU_IMAGE_IO_MODE   writeback (default) | direct
+ *
+ * "direct" opens a second descriptor on the pages image with O_DIRECT and uses
+ * it for jobs whose offset, buffers and lengths are all block-aligned, falling
+ * back to the buffered descriptor for the rest. Off by default because it is
+ * only the right trade when the page cache is cold: a same-host restore
+ * usually finds the image still cached, and bypassing that is a straight loss.
+ */
+
+#define PR_AIO_DEPTH_DEFAULT 128
+#define PR_AIO_DEPTH_MAX     1024
+#define PR_DIRECT_ALIGN	     512
+
+static inline int cr_io_setup(unsigned int nr, aio_context_t *ctx)
+{
+	return syscall(__NR_io_setup, nr, ctx);
+}
+
+static inline int cr_io_destroy(aio_context_t ctx)
+{
+	return syscall(__NR_io_destroy, ctx);
+}
+
+static inline int cr_io_submit(aio_context_t ctx, long nr, struct iocb **cbs)
+{
+	return syscall(__NR_io_submit, ctx, nr, cbs);
+}
+
+static inline int cr_io_getevents(aio_context_t ctx, long min_nr, long nr, struct io_event *ev)
+{
+	return syscall(__NR_io_getevents, ctx, min_nr, nr, ev, NULL);
+}
+
+static unsigned int pr_aio_depth(void)
+{
+	const char *env = getenv("CRIU_AIO_DEPTH");
+	char *end;
+	long v;
+
+	if (!env || !*env)
+		return PR_AIO_DEPTH_DEFAULT;
+
+	v = strtol(env, &end, 10);
+	if (*end || v < 0 || v > PR_AIO_DEPTH_MAX) {
+		pr_warn("Ignoring bad CRIU_AIO_DEPTH=%s\n", env);
+		return PR_AIO_DEPTH_DEFAULT;
+	}
+
+	return (unsigned int)v;
+}
+
+static bool pr_io_direct(void)
+{
+	const char *env = getenv("CRIU_IMAGE_IO_MODE");
+
+	return env && !strcmp(env, "direct");
+}
+
+/* Every part of the read has to be block-aligned for O_DIRECT to take it. */
+static bool piov_is_aligned(struct page_read_iov *piov)
+{
+	unsigned int i;
+
+	if (piov->from % PR_DIRECT_ALIGN)
+		return false;
+
+	for (i = 0; i < piov->nr; i++) {
+		if ((unsigned long)piov->to[i].iov_base % PR_DIRECT_ALIGN)
+			return false;
+		if (piov->to[i].iov_len % PR_DIRECT_ALIGN)
+			return false;
+	}
+
+	return true;
+}
+
+/*
+ * A second descriptor on the same image, opened O_DIRECT. Re-opening through
+ * /proc/self/fd keeps this independent of how the image was originally opened
+ * and leaves the buffered descriptor untouched for whatever cannot be aligned.
+ */
+static int pr_open_direct_fd(int fd)
+{
+	char path[64];
+	int dfd;
+
+	snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+	dfd = open(path, O_RDONLY | O_DIRECT);
+	if (dfd < 0)
+		pr_info("O_DIRECT unavailable for the pages image (%s); using buffered reads\n", strerror(errno));
+
+	return dfd;
+}
+
+struct pr_aio_job {
+	struct page_read_iov *piov;
+	/*
+	 * advance_piov() walks piov->to forward on a short read, so the
+	 * pointer that has to be freed is kept separately -- exactly as the
+	 * serial path keeps its own copy.
+	 */
+	struct iovec *orig_to;
+};
+
+struct pr_aio_slot {
+	struct iocb cb;
+	int job; /* index into jobs[], or -1 when the slot is free */
+};
+
+static int process_async_reads_serial(struct page_read *pr);
+static int process_async_reads(struct page_read *pr);
+
+static int process_async_reads_aio(struct page_read *pr, unsigned int depth)
+{
+	struct pr_aio_job *jobs = NULL;
+	struct pr_aio_slot *slots = NULL;
+	struct iocb **batch = NULL;
+	struct io_event *events = NULL;
+	int *retry = NULL;
+	unsigned int nr_jobs = 0, nr_retry = 0, next = 0, in_flight = 0, i;
+	unsigned long direct_jobs = 0, submitted_jobs = 0;
+	struct page_read_iov *piov;
+	aio_context_t ctx = 0;
+	int fd, dfd = -1, ret = -1;
+
+	fd = img_raw_fd(pr->pi);
+	if (fd < 0) {
+		pr_err("Failed getting raw image fd\n");
+		return -1;
+	}
+
+	list_for_each_entry(piov, &pr->async, l)
+		nr_jobs++;
+
+	if (!nr_jobs)
+		return pr->parent ? process_async_reads(pr->parent) : 0;
+
+	if (depth > nr_jobs)
+		depth = nr_jobs;
+
+	jobs = xzalloc(nr_jobs * sizeof(*jobs));
+	retry = xzalloc(nr_jobs * sizeof(*retry));
+	slots = xzalloc(depth * sizeof(*slots));
+	batch = xzalloc(depth * sizeof(*batch));
+	events = xzalloc(depth * sizeof(*events));
+	if (!jobs || !retry || !slots || !batch || !events)
+		goto out_free;
+
+	i = 0;
+	list_for_each_entry(piov, &pr->async, l) {
+		jobs[i].piov = piov;
+		jobs[i].orig_to = piov->to;
+		i++;
+	}
+
+	for (i = 0; i < depth; i++)
+		slots[i].job = -1;
+
+	if (cr_io_setup(depth, &ctx) < 0) {
+		/*
+		 * aio-max-nr is a global budget and can legitimately be
+		 * exhausted by other tasks on the node. Not an error -- just
+		 * do it the old way.
+		 */
+		pr_info("Can't set up an AIO context of depth %u (%s); using preadv\n", depth, strerror(errno));
+		xfree(jobs);
+		xfree(retry);
+		xfree(slots);
+		xfree(batch);
+		xfree(events);
+		return process_async_reads_serial(pr);
+	}
+
+	if (pr_io_direct())
+		dfd = pr_open_direct_fd(fd);
+
+	while (next < nr_jobs || nr_retry || in_flight) {
+		unsigned int nr_batch = 0;
+
+		for (i = 0; i < depth; i++) {
+			struct pr_aio_slot *slot = &slots[i];
+			struct pr_aio_job *job;
+			int j;
+
+			if (slot->job != -1)
+				continue;
+
+			if (nr_retry)
+				j = retry[--nr_retry];
+			else if (next < nr_jobs)
+				j = next++;
+			else
+				break;
+
+			job = &jobs[j];
+			slot->job = j;
+			in_flight++;
+
+			memset(&slot->cb, 0, sizeof(slot->cb));
+			slot->cb.aio_lio_opcode = IOCB_CMD_PREADV;
+			slot->cb.aio_fildes = fd;
+			slot->cb.aio_buf = (unsigned long)job->piov->to;
+			slot->cb.aio_nbytes = job->piov->nr;
+			slot->cb.aio_offset = job->piov->from;
+			slot->cb.aio_data = (unsigned long)slot;
+
+			if (dfd >= 0 && piov_is_aligned(job->piov)) {
+				slot->cb.aio_fildes = dfd;
+				direct_jobs++;
+			}
+
+			batch[nr_batch++] = &slot->cb;
+		}
+
+		if (nr_batch) {
+			int nr_sub = cr_io_submit(ctx, nr_batch, batch);
+
+			if (nr_sub < 0) {
+				pr_perror("Can't submit %u AIO reads", nr_batch);
+				goto out;
+			}
+
+			/*
+			 * A partial submit is allowed. Hand the slots that
+			 * were not taken back to the retry list; the next
+			 * pass re-fills them.
+			 */
+			for (i = nr_sub; i < nr_batch; i++) {
+				struct pr_aio_slot *slot = container_of(batch[i], struct pr_aio_slot, cb);
+
+				retry[nr_retry++] = slot->job;
+				slot->job = -1;
+				in_flight--;
+			}
+
+			submitted_jobs += nr_sub;
+
+			if (nr_sub == 0 && in_flight == 0) {
+				pr_err("AIO submit accepted nothing and nothing is in flight\n");
+				goto out;
+			}
+		}
+
+		if (!in_flight)
+			continue;
+
+		{
+			int got = cr_io_getevents(ctx, 1, in_flight, events);
+
+			if (got < 0) {
+				if (errno == EINTR)
+					continue;
+				pr_perror("Can't reap AIO events");
+				goto out;
+			}
+
+			for (i = 0; i < (unsigned int)got; i++) {
+				struct pr_aio_slot *slot = (struct pr_aio_slot *)(unsigned long)events[i].data;
+				struct pr_aio_job *job = &jobs[slot->job];
+				struct page_read_iov *done = job->piov;
+				long res = events[i].res;
+
+				slot->job = -1;
+				in_flight--;
+
+				if (res < 0) {
+					pr_err("Can't read async pr bytes (%ld / %ju read, %ju off, %d iovs)\n", res,
+					       done->end - done->from, done->from, done->nr);
+					goto out;
+				}
+
+				if (res != done->end - done->from) {
+					/*
+					 * Short read. Same rule as preadv():
+					 * valid, and not EOF. Advance the job
+					 * and queue the remainder -- it keeps
+					 * its own slot in jobs[], so there is
+					 * no way for it to be submitted twice.
+					 */
+					if (res == 0) {
+						pr_err("AIO read returned 0 at %ju, %d iovs left\n", done->from,
+						       done->nr);
+						goto out;
+					}
+					advance_piov(done, res);
+					retry[nr_retry++] = (int)(job - jobs);
+					continue;
+				}
+
+				BUG_ON(pr->io_complete); /* FIXME -- implement once needed */
+
+				list_del(&done->l);
+				xfree(job->orig_to);
+				xfree(done);
+				job->piov = NULL;
+			}
+		}
+	}
+
+	if (dfd >= 0)
+		pr_debug("AIO: %lu of %lu submissions used O_DIRECT\n", direct_jobs, submitted_jobs);
+
+	ret = 0;
+out:
+	/*
+	 * io_destroy() waits for outstanding requests to finish, so no
+	 * destination buffer is written to after this returns.
+	 */
+	cr_io_destroy(ctx);
+	if (dfd >= 0)
+		close(dfd);
+out_free:
+	xfree(jobs);
+	xfree(retry);
+	xfree(slots);
+	xfree(batch);
+	xfree(events);
+
+	if (ret == 0 && pr->parent)
+		ret = process_async_reads(pr->parent);
+
+	return ret;
+}
+
 static int process_async_reads(struct page_read *pr)
+{
+	unsigned int depth = pr_aio_depth();
+
+	if (depth >= 2 && !opts.auto_dedup && !list_empty(&pr->async))
+		return process_async_reads_aio(pr, depth);
+
+	return process_async_reads_serial(pr);
+}
+
+static int process_async_reads_serial(struct page_read *pr)
 {
 	int fd, ret = 0;
 	struct page_read_iov *piov, *n;
