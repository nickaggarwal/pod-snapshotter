FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/agent ./cmd/agent

# The agent needs nsenter (util-linux) to exec the HOST's runc / criu /
# cuda-checkpoint — it deliberately ships none of those binaries itself, so
# there is no version skew with the node's NVIDIA driver or CRIU install.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends util-linux ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/agent /agent
ENTRYPOINT ["/agent"]
